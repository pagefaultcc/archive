# Public frontend binding. Keep loopback-only while using development credentials.
APP_PORT=3000
# Must be the externally visible absolute origin and match APP_PORT.
PUBLIC_ORIGIN=http://localhost:3000

POSTGRES_DB=archive
POSTGRES_USER=archive
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD

# Required only for first bootstrap. Values are never baked into images.
ROOT_USERNAME=REPLACE_WITH_ROOT_USERNAME
ROOT_PASSWORD=REPLACE_WITH_A_STRONG_ROOT_PASSWORD
